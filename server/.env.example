# 开发环境配置
# 生产环境请通过环境变量设置，不要使用此文件

# JWT 密钥 - 用于签名 token
# 生产环境必须使用更复杂的密钥（至少 32 位），并通过环境变量设置
JWT_SECRET=dev-jwt-secret-change-in-production-abc123xyz789-2026

# 运行环境
NODE_ENV=development

# 服务器端口
PORT=3000

# Cookie 安全设置（生产环境应设置为 true）
SECURE_COOKIE=false

# 允许的源（生产环境应设置为实际域名）
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
