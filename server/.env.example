# 开发环境配置
# 复制此文件为 .env 并填入真实值
# 注意：.env 文件不应提交到版本控制系统

# JWT 密钥 - 生产环境必须使用强密钥（至少32位）
JWT_SECRET=your-jwt-secret-at-least-32-chars-long

# 运行环境
NODE_ENV=development

# 服务器端口
PORT=3000

# Cookie 安全设置（生产环境启用 HTTPS 后设置为 true）
SECURE_COOKIE=false

# 允许的源（生产环境应设置为实际域名）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173

# 数据库配置
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trainer_ai_tool
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# 连接池配置
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=30000
DB_TIMEOUT=60000

# 数据库日志
DB_LOGGING=false

# 数据加密密钥 - 64 位 hex 字符串（32 字节 = AES-256）
# 生产环境必须设置，否则每次重启会生成新密钥导致已加密数据无法解密
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
