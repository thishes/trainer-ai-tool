# ============================================
# Trainer AI Tool - 生产环境配置
# ============================================

# --------------------------------------------
# 基础配置
# --------------------------------------------
NODE_ENV=production
PORT=3000
BASE_URL=https://kb.thishe.com

# --------------------------------------------
# 安全配置
# --------------------------------------------
JWT_SECRET=kb-thishe-com-prod-2026-secure-token-change-weekly
SECURE_COOKIE=true
ALLOWED_ORIGINS=https://kb.thishe.com

# --------------------------------------------
# 数据库配置 - 远程 MySQL 8.0.45
# --------------------------------------------
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trainer_ai_tool
DB_USER=root
DB_PASSWORD=

# 连接池配置
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=30000
DB_TIMEOUT=60000

# MySQL 连接超时（毫秒）
DB_CONNECT_TIMEOUT=30000

# 数据库查询日志（生产环境建议关闭）
DB_LOGGING=false

# 慢查询阈值（毫秒）
SLOW_QUERY_THRESHOLD=1000

# 双写模式（纯 MySQL 环境设为 false）
DUAL_WRITE=false

# --------------------------------------------
# Redis 缓存配置
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=3600
CACHE_ENABLED=false
