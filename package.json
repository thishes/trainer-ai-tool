{
  "name": "trainer-ai-tool",
  "version": "1.0.4",
  "description": "培训师AI测试工具 - 专为培训场景设计的AI测试工具",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "client": "cd client && npm run serve",
    "build": "cd client && npm run build",
    "build:server": "echo 'Server build complete'",
    "install-all": "npm install && cd client && npm install",
    "update:check": "node server/scripts/update-script.js check",
    "update:run": "node server/scripts/update-script.js update",
    "db:indexes": "node scripts/manage-indexes.js",
    "db:indexes:create": "node scripts/manage-indexes.js create",
    "db:indexes:drop": "node scripts/manage-indexes.js drop -y"
  },
  "keywords": [
    "training",
    "quiz",
    "ai",
    "exam"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.20.0",
    "node-fetch": "^2.7.0",
    "qrcode": "^1.5.3",
    "redis": "^5.11.0",
    "sequelize": "^6.33.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
