# ============================================
# Trainer AI Tool - 本地开发环境配置
# ============================================

# --------------------------------------------
# 基础配置
# --------------------------------------------
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# --------------------------------------------
# 安全配置
# --------------------------------------------
JWT_SECRET=dev-local-2026-secret-key-not-for-production
SECURE_COOKIE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --------------------------------------------
# 数据库配置 - 本地 MySQL
# --------------------------------------------
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trainer_ai_tool
DB_USER=root
DB_PASSWORD=Hejinqiang860612!

# 连接池配置
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_TIMEOUT=10000

# MySQL 连接超时（毫秒）
DB_CONNECT_TIMEOUT=10000

# 数据库查询日志（开发环境开启）
DB_LOGGING=true

# 慢查询阈值（毫秒）
SLOW_QUERY_THRESHOLD=1000

# 双写模式
DUAL_WRITE=false

# --------------------------------------------
# Redis 缓存配置
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=3600
CACHE_ENABLED=false
