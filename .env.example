# 服务器端口
PORT=3000

# 生产环境标识（设为 "production" 启用安全模式）
NODE_ENV=development

# JWT 密钥（生产环境必须设置为 32 位以上复杂随机字符串）
# 开发环境会自动生成，开发环境请勿用于生产
# JWT_SECRET=请在生产环境修改为 32 位以上随机字符串

# 安全 Cookie 标识（生产环境自动启用）
SECURE_COOKIE=false

# 前端访问地址（用于生成考试链接，部署时修改为实际域名或 IP）
BASE_URL=http://localhost:3000

# 允许的跨域来源（生产环境设置实际域名，多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# 数据库配置
# ============================================
DB_NAME=trainer_ai_tool
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost

# 数据库连接池配置
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# 数据库查询日志
DB_LOGGING=true

# 慢查询阈值 (毫秒)
SLOW_QUERY_THRESHOLD=1000

# ============================================
# Redis 缓存配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=3600
CACHE_ENABLED=true
