# 服务器端口
PORT=3000

# 生产环境标识（设为 "production" 启用安全模式）
NODE_ENV=development

# JWT密钥（生产环境必须设置为32位以上复杂随机字符串）
# 开发环境会自动生成，开发环境请勿用于生产
# JWT_SECRET=请在生产环境修改为32位以上随机字符串

# 安全Cookie标识（生产环境自动启用）
SECURE_COOKIE=false

# 前端访问地址（用于生成考试链接，部署时修改为实际域名或IP）
BASE_URL=http://localhost:3000

# 允许的跨域来源（生产环境设置实际域名，多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
