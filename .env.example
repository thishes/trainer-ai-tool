# ============================================
# Trainer AI Tool - 环境配置模板
# 使用方法：复制此文件为 .env，然后填入实际值
#   cp .env.example .env
# ============================================

# --------------------------------------------
# 基础配置
# --------------------------------------------
# 运行环境（development / production）
NODE_ENV=development

# 服务器端口
PORT=3000

# 前端访问地址（用于生成考试链接，部署时修改为实际域名或 IP）
BASE_URL=http://localhost:3000

# --------------------------------------------
# 安全配置
# --------------------------------------------
# JWT 密钥（生产环境必须使用 32 位以上复杂随机字符串）
# 生成方法：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars

# 安全 Cookie 标识（生产环境设为 true，需 HTTPS）
SECURE_COOKIE=false

# 允许的跨域来源（多个用逗号分隔，生产环境设置实际域名）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --------------------------------------------
# 数据库配置
# --------------------------------------------
# 数据库类型（mysql / json）
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trainer_ai_tool
DB_USER=root
DB_PASSWORD=

# 连接池配置
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_TIMEOUT=30000

# MySQL 连接超时（毫秒，远程数据库建议 30000）
DB_CONNECT_TIMEOUT=15000

# 数据库查询日志（生产环境建议关闭）
DB_LOGGING=false

# 慢查询阈值（毫秒）
SLOW_QUERY_THRESHOLD=1000

# 双写模式（纯 MySQL 环境设为 false，混合模式设为 true）
DUAL_WRITE=false

# --------------------------------------------
# Redis 缓存配置
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=3600
CACHE_ENABLED=false
