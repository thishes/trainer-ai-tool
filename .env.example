# 服务器端口
PORT=3000

# 生产环境标识（设为 "production" 启用安全模式）
NODE_ENV=development

# JWT密钥（生产环境必须修改为复杂随机字符串）
JWT_SECRET=trainer-ai-tool-secret-key

# 安全Cookie标识（生产环境设为 "true" 启用HTTPS安全Cookie）
SECURE_COOKIE=false

# 前端访问地址（用于生成考试链接，部署时修改为实际域名或IP）
BASE_URL=http://localhost:3000

# 允许的跨域来源（生产环境设置实际域名，多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 数据库路径（可选，默认使用db.json）
# DB_PATH=./data/db.json
